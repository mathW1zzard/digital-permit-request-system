# Week 16 staging settings. The real file is <staging>/shared/.env, created by setup.sh with
# generated secrets; it is never committed. Values in <...> are filled in by setup.sh.
APP_NAME="Permit Requests (staging)"
APP_ENV=staging
APP_KEY=<generated by php artisan key:generate --show>
APP_DEBUG=false
APP_URL=https://localhost:8444
FRONTEND_ORIGIN=https://localhost:8444

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning
PERMIT_LOG_PATH=<staging>/shared/storage/logs/permit.jsonl

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=permit_staging
DB_USERNAME=permit_app
DB_PASSWORD=<generated, 24 random characters>

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

REQUIRE_HTTPS=true
API_RATE_PER_MINUTE=60
MAX_BODY_KB=1024
DEMO_PASSWORD=<generated for staging, different from development>

GATEWAY_URL=https://127.0.0.1:9444/send
GATEWAY_DISPATCH_BATCH=200
GATEWAY_CA_FILE=<repo>/certs/dev-ca.pem
GATEWAY_API_KEY=<same as the mock gateway's key in backend/.env>
GATEWAY_PAYLOAD_KEY_ID=<same as backend/.env>
GATEWAY_PAYLOAD_KEY=<same as backend/.env>
